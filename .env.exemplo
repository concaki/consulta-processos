# Copie este arquivo para ".env" e preencha as chaves que tiver.
# Sem chave, a fonte correspondente só mostra um aviso — o resto funciona normalmente.

# Portal da Transparência (GRATUITA): cadastre o e-mail em
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=

# Escavador (PAGA, consome créditos por consulta): https://api.escavador.com
ESCAVADOR_TOKEN=

# Só preencha se o Querido Diário mudar de endereço de novo (padrão: https://api.queridodiario.org.br)
QD_API_URL=

# Só preencha se o CNJ trocar a chave pública do DataJud:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=
